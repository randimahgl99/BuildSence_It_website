# Web3Forms public access key for the /contact demo request form.
# Copy this file to .env.local and paste the key from https://web3forms.com (dashboard).
# The key is public by design (it ships in the browser bundle); restart `npm run dev` after changing it.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Canonical site origin (e.g. https://example.com, no trailing slash needed). Used for the
# sitemap, robots.txt, canonical/Open Graph URLs and JSON-LD. Leave empty locally; set it in
# the hosting environment before launch (on Vercel it falls back to the production domain).
SITE_URL=
